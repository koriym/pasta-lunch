{
    "name": "koriym/pasta-lunch",
    "description": "Detect spaghetti code using PHPMD metrics",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Akihito Koriyama",
            "email": "akihito.koriyama@gmail.com"
        }
    ],
    "require": {
        "php": "^8.1"
    },
    "bin": [
        "bin/pasta-lunch"
    ],
    "scripts": {
        "pasta": "bin/pasta-lunch",
        "pasta:html": "bin/pasta-lunch --format=html"
    },
    "require-dev": {
        "phpmd/phpmd": "^2.15"
    }
}
