#!/usr/bin/env php
<?php

declare(strict_types=1);

/**
 * Spaghetti Code Detector
 *
 * Usage: ./bin/spaghetti [target_dir] [--exclude=pattern] [--format=md|html]
 * Example: ./bin/spaghetti src/Resource
 *          ./bin/spaghetti src --exclude="*Module.php"
 *          ./bin/spaghetti src --format=html > report.html
 */

// Thresholds for each level [Piccolo, Medio, Grande] - above Grande = Mamma Mia!
const THRESHOLDS = [
    'CouplingBetweenObjects' => [10, 13, 17],  // CBO: ≤10, 11-13, 14-17, 18+
    'CyclomaticComplexity' => [10, 15, 20],    // CC: ≤10, 11-15, 16-20, 21+
    'NPathComplexity' => [50, 200, 500],       // NPath: ≤50, 51-200, 201-500, 501+
    'ExcessiveClassComplexity' => [50, 80, 100],// ECC: ≤50, 51-80, 81-100, 101+
    'ExcessiveMethodLength' => [50, 100, 150],
    'ExcessiveParameterList' => [5, 10, 15],
    'TooManyFields' => [10, 15, 20],
    'TooManyPublicMethods' => [10, 15, 20],
];

const LEVELS = [
    1 => ['emoji' => '🍝', 'name' => 'Piccolo'],
    2 => ['emoji' => '🍝🍝', 'name' => 'Medio'],
    3 => ['emoji' => '🍝🍝🍝', 'name' => 'Grande'],
    4 => ['emoji' => '🍝🍝🍝🍝', 'name' => 'Mamma Mia!'],
];

const METRIC_THRESHOLDS = [
    'CouplingBetweenObjects' => 10,
    'CyclomaticComplexity' => 10,
    'NPathComplexity' => 50,
    'ExcessiveClassComplexity' => 50,
    'ExcessiveMethodLength' => 50,
    'ExcessiveParameterList' => 5,
    'TooManyFields' => 12,
    'TooManyPublicMethods' => 12,
];

const LEVEL_BADGES = [
    4 => '⚠️⚠️ Unmaintainable',
    3 => '⚠️ Refactoring required',
    2 => 'Acceptable',
    1 => 'Clean code',
];

function getLevel(string $metric, int $value): int
{
    if (!isset(THRESHOLDS[$metric])) {
        return 2;
    }
    $thresholds = THRESHOLDS[$metric];
    if ($value <= $thresholds[0]) return 1;
    if ($value <= $thresholds[1]) return 2;
    if ($value <= $thresholds[2]) return 3;
    return 4;
}

function parsePhpmdOutput(string $output): array
{
    $files = [];
    foreach (explode("\n", trim($output)) as $line) {
        if (empty($line)) continue;
        if (preg_match('/^(.+?):(\d+)\s+(\w+)\s+(.+)$/', $line, $matches)) {
            $filePath = $matches[1];
            $lineNum = (int)$matches[2];
            $metric = $matches[3];
            $description = $matches[4];
            $value = 0;
            if (preg_match('/(\d+)/', $description, $numMatch)) {
                $value = (int)$numMatch[1];
            }
            $relativePath = preg_replace('#^.*/src/#', 'src/', $filePath);
            if (!isset($files[$relativePath])) {
                $files[$relativePath] = ['path' => $relativePath, 'issues' => [], 'maxLevel' => 1];
            }
            $level = getLevel($metric, $value);
            $files[$relativePath]['issues'][] = [
                'metric' => $metric, 'value' => $value, 'line' => $lineNum, 'level' => $level,
            ];
            if ($level > $files[$relativePath]['maxLevel']) {
                $files[$relativePath]['maxLevel'] = $level;
            }
        }
    }
    uasort($files, fn($a, $b) => $b['maxLevel'] <=> $a['maxLevel']);
    return $files;
}

function matchesExcludePattern(string $path, array $patterns): bool
{
    foreach ($patterns as $pattern) {
        if (fnmatch($pattern, basename($path))) {
            return true;
        }
    }
    return false;
}

function getReportData(array $files): array
{
    $targetDirs = explode(',', $GLOBALS['targetDir']);
    $allPhpFiles = [];
    foreach ($targetDirs as $dir) {
        $dir = trim($dir);
        if (is_dir($dir)) {
            $iterator = new RecursiveIteratorIterator(
                new RecursiveDirectoryIterator($dir, RecursiveDirectoryIterator::SKIP_DOTS)
            );
            foreach ($iterator as $file) {
                if ($file->isFile() && $file->getExtension() === 'php') {
                    $allPhpFiles[] = $file->getPathname();
                }
            }
        }
    }

    $grouped = [4 => [], 3 => [], 2 => [], 1 => []];
    $filesWithIssues = [];
    foreach ($files as $file) {
        $grouped[$file['maxLevel']][] = $file;
        $filesWithIssues[] = realpath($file['path']) ?: $file['path'];
    }

    foreach ($allPhpFiles as $phpFile) {
        $realPath = realpath($phpFile);
        $found = false;
        foreach ($filesWithIssues as $issueFile) {
            if ($realPath === $issueFile || str_ends_with($issueFile, basename($phpFile))) {
                $found = true;
                break;
            }
        }
        if (!$found && !matchesExcludePattern($phpFile, $GLOBALS['excludePatterns'])) {
            $grouped[1][] = ['path' => $phpFile, 'maxLevel' => 1, 'issues' => []];
        }
    }

    $counts = [4 => count($grouped[4]), 3 => count($grouped[3]), 2 => count($grouped[2]), 1 => count($grouped[1])];

    return [
        'totalFiles' => count($allPhpFiles),
        'grouped' => $grouped,
        'counts' => $counts,
    ];
}

function printMarkdown(array $data): void
{
    $grouped = $data['grouped'];
    $counts = $data['counts'];

    echo "## 🍝 Spaghetti Code Detection ({$data['totalFiles']} files)\n\n";

    foreach ([4, 3, 2, 1] as $levelNum) {
        $lvl = LEVELS[$levelNum];
        $count = count($grouped[$levelNum]);
        if ($count === 0) continue;

        echo "### {$lvl['emoji']} {$lvl['name']} ({$count})\n\n";
        if ($levelNum === 1) {
            echo "(Remaining files)\n\n";
            continue;
        }
        $fileNames = array_map(fn($f) => preg_replace('#^.*/src/(Resource/)?#', '', $f['path']), $grouped[$levelNum]);
        echo implode(', ', $fileNames) . "\n\n";
    }

    $detailFiles = array_merge($grouped[4], $grouped[3], $grouped[2]);
    if (!empty($detailFiles)) {
        echo "---\n\n## Details\n\n";
        foreach ($detailFiles as $file) {
            $shortPath = preg_replace('#^src/(Resource/)?#', '', $file['path']);
            $lvl = LEVELS[$file['maxLevel']];
            echo "### {$shortPath} {$lvl['emoji']} {$lvl['name']}\n\n**Issues:**\n";
            foreach ($file['issues'] as $issue) {
                if ($issue['level'] >= 2) {
                    $threshold = METRIC_THRESHOLDS[$issue['metric']] ?? '?';
                    $lineInfo = $issue['line'] > 0 ? ":L{$issue['line']}" : "";
                    echo "- {$issue['metric']}: {$issue['value']}({$threshold}){$lineInfo}\n";
                }
            }
            echo "\n";
        }
    }

    echo "---\n\n### Summary\n\n";
    echo "| Level | | Files |\n|-------|---|-------|\n";
    echo "| 🍝🍝🍝🍝 Mamma Mia! | ⚠️⚠️ Unmaintainable | {$counts[4]} |\n";
    echo "| 🍝🍝🍝 Grande | ⚠️ Refactoring required | {$counts[3]} |\n";
    echo "| 🍝🍝 Medio | Acceptable | {$counts[2]} |\n";
    echo "| 🍝 Piccolo | Clean code | {$counts[1]} |\n";
}

function printHtml(array $data): void
{
    $grouped = $data['grouped'];
    $counts = $data['counts'];

    $css = <<<'CSS'
:root{--color-mamma-mia:#dc3545;--color-grande:#fd7e14;--color-normale:#ffc107;--color-piccolo:#28a745;--color-bg:#fff;--color-bg-secondary:#f6f8fa;--color-border:#d0d7de;--color-text:#1f2328;--color-text-muted:#656d76;--color-link:#0969da}
*{box-sizing:border-box}
body{font-family:-apple-system,BlinkMacSystemFont,'Segoe UI','Noto Sans',Helvetica,Arial,sans-serif;font-size:14px;line-height:1.5;color:var(--color-text);background:var(--color-bg);margin:0;padding:32px;max-width:1200px;margin:0 auto}
h1{font-size:2em;border-bottom:1px solid var(--color-border);padding-bottom:.3em}
h2{font-size:1.5em;border-bottom:1px solid var(--color-border);padding-bottom:.3em;margin-top:24px}
h3{font-size:1.25em;margin-top:24px}
.badge{display:inline-block;padding:2px 8px;border-radius:12px;font-size:12px;font-weight:500;color:#fff}
.badge-4{background:var(--color-mamma-mia)}
.badge-3{background:var(--color-grande)}
.badge-2{background:var(--color-normale);color:#1f2328}
.badge-1{background:var(--color-piccolo)}
.status-4{color:var(--color-mamma-mia);font-weight:500}
.status-3{color:var(--color-grande);font-weight:500}
.status-2{color:#996f00;font-weight:500}
.status-1{color:var(--color-piccolo);font-weight:500}
.pasta{font-size:1.5em;vertical-align:middle}
table{border-collapse:collapse;margin:16px 0}
th,td{padding:8px 16px;text-align:left;border:1px solid var(--color-border)}
td:last-child{text-align:right;white-space:nowrap}
th{background:var(--color-bg-secondary);font-weight:600}
tr:hover{background:var(--color-bg-secondary)}
.level-section{margin:24px 0;padding:16px;border-left:4px solid;background:var(--color-bg-secondary);border-radius:0 6px 6px 0}
.level-4{border-left-color:var(--color-mamma-mia)}
.level-3{border-left-color:var(--color-grande)}
.level-2{border-left-color:var(--color-normale)}
.level-1{border-left-color:var(--color-piccolo)}
.file-list{margin-top:8px;font-family:monospace;font-size:12px;line-height:1.8}
.file-list a{color:var(--color-link);text-decoration:none}
.file-list a:hover{text-decoration:underline}
.issue-list{margin:8px 0;padding-left:20px}
.issue-item{margin:4px 0;font-family:monospace;font-size:13px}
.metric-name{font-weight:600}
.metric-value{color:var(--color-mamma-mia)}
.metric-threshold{color:var(--color-text-muted)}
.metric-line{color:var(--color-link)}
.detail-card{background:#fff;border:1px solid var(--color-border);border-radius:6px;padding:16px;margin:12px 0}
.detail-header{display:flex;justify-content:space-between;align-items:center;margin-bottom:12px}
.detail-path{font-family:monospace;font-weight:600}
.remaining{color:var(--color-text-muted);font-style:italic}
CSS;

    echo "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n";
    echo "<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1.0\">\n";
    echo "<title>🍝 Spaghetti Code Detection</title>\n<style>{$css}</style>\n</head>\n<body>\n";
    echo "<h1>🍝 Spaghetti Code Detection</h1>\n<p>{$data['totalFiles']} files analyzed</p>\n";

    $total = $data['totalFiles'];
    echo "<table><thead><tr><th>Level</th><th>Status</th><th>Files</th></tr></thead><tbody>\n";
    foreach ([4, 3, 2, 1] as $n) {
        $l = LEVELS[$n];
        $pct = $total > 0 ? number_format($counts[$n] / $total * 100, 1) : '0.0';
        echo "<tr><td><span class=\"pasta\">{$l['emoji']}</span> {$l['name']}</td><td><span class=\"status-{$n}\">" . LEVEL_BADGES[$n] . "</span></td><td>{$counts[$n]} ({$pct}%)</td></tr>\n";
    }
    echo "</tbody></table>\n<h2>Files by Level</h2>\n";

    foreach ([4, 3, 2, 1] as $levelNum) {
        $lvl = LEVELS[$levelNum];
        $count = count($grouped[$levelNum]);
        if ($count === 0) continue;

        echo "<div class=\"level-section level-{$levelNum}\"><h3><span class=\"pasta\">{$lvl['emoji']}</span> {$lvl['name']} ({$count})</h3>\n";
        if ($levelNum === 1) {
            echo "<p class=\"remaining\">(Remaining files)</p></div>\n";
            continue;
        }
        $fileLinks = array_map(function($f) {
            $shortPath = preg_replace('#^(.*/)?src/(Resource/)?#', '', $f['path']);
            $id = preg_replace('/[^a-zA-Z0-9]/', '-', $shortPath);
            return "<a href=\"#file-{$id}\">" . htmlspecialchars($shortPath) . "</a>";
        }, $grouped[$levelNum]);
        echo "<div class=\"file-list\">" . implode(', ', $fileLinks) . "</div></div>\n";
    }

    $detailFiles = array_merge($grouped[4], $grouped[3], $grouped[2]);
    if (!empty($detailFiles)) {
        echo "<h2>Details</h2>\n";
        foreach ($detailFiles as $file) {
            $shortPath = preg_replace('#^(.*/)?src/(Resource/)?#', '', $file['path']);
            $id = preg_replace('/[^a-zA-Z0-9]/', '-', $shortPath);
            $lvl = LEVELS[$file['maxLevel']];
            $levelNum = $file['maxLevel'];
            echo "<div class=\"detail-card\" id=\"file-{$id}\"><div class=\"detail-header\">";
            echo "<span class=\"detail-path\">" . htmlspecialchars($shortPath) . "</span>";
            echo "<span class=\"badge badge-{$levelNum}\">{$lvl['emoji']} {$lvl['name']}</span></div>\n";
            echo "<ul class=\"issue-list\">\n";
            foreach ($file['issues'] as $issue) {
                if ($issue['level'] >= 2) {
                    $threshold = METRIC_THRESHOLDS[$issue['metric']] ?? '?';
                    $lineInfo = $issue['line'] > 0 ? "<span class=\"metric-line\">:L{$issue['line']}</span>" : "";
                    echo "<li class=\"issue-item\"><span class=\"metric-name\">{$issue['metric']}</span>: ";
                    echo "<span class=\"metric-value\">{$issue['value']}</span>";
                    echo "<span class=\"metric-threshold\">({$threshold})</span>{$lineInfo}</li>\n";
                }
            }
            echo "</ul></div>\n";
        }
    }

    echo "</body></html>\n";
}

// Main
$targetDir = 'src/Resource,src/Service,src/Helper,src/Domain';
$excludePatterns = ['*Module.php'];
$format = 'md';

foreach ($argv as $i => $arg) {
    if ($i === 0) continue;
    if (str_starts_with($arg, '--exclude=')) {
        $excludePatterns = array_map('trim', explode(',', substr($arg, 10)));
    } elseif ($arg === '--no-exclude') {
        $excludePatterns = [];
    } elseif (str_starts_with($arg, '--format=')) {
        $format = substr($arg, 9);
    } elseif (!str_starts_with($arg, '--')) {
        $targetDir = $arg;
    }
}

$phpmdPaths = ['./vendor/bin/phpmd', './vendor-bin/tools/vendor/bin/phpmd'];
$phpmd = null;
foreach ($phpmdPaths as $path) {
    if (file_exists($path)) {
        $phpmd = $path;
        break;
    }
}

if (!$phpmd) {
    fwrite(STDERR, "Error: phpmd not found\n");
    exit(1);
}

$cmd = sprintf('php -d error_reporting=E_ERROR %s %s text codesize,design 2>/dev/null', escapeshellarg($phpmd), escapeshellarg($targetDir));
$output = shell_exec($cmd) ?? '';

if (empty(trim($output))) {
    echo $format === 'html'
        ? "<!DOCTYPE html><html><head><title>Clean</title></head><body><h1>🍝 Spaghetti Code Detection</h1><p>All clean! No issues detected.</p></body></html>\n"
        : "## 🍝 Spaghetti Code Detection\n\n✨ All clean! No issues detected.\n";
    exit(0);
}

$files = parsePhpmdOutput($output);
if (!empty($excludePatterns)) {
    $files = array_filter($files, fn($file) => !matchesExcludePattern($file['path'], $excludePatterns));
}

$data = getReportData($files);
$format === 'html' ? printHtml($data) : printMarkdown($data);
