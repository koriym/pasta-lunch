#!/usr/bin/env php
<?php

declare(strict_types=1);

/**
 * PASTA - PHP Alert for Spaghetti Twisted Architecture
 *
 * Usage: ./bin/pasta [target_dir] [--exclude=pattern] [--format=text|md|html]
 * Example: ./bin/pasta src/Resource
 *          ./bin/pasta src --exclude="*Module.php"
 *          ./bin/pasta src --format=md > report.md
 *          ./bin/pasta src --format=html > report.html
 */

use Koriym\PastaLunch\Pasta;

$autoloadPaths = [
    __DIR__ . '/../vendor/autoload.php',
    __DIR__ . '/../../../autoload.php',
];

$autoloaderFound = false;
foreach ($autoloadPaths as $autoload) {
    if (file_exists($autoload)) {
        require $autoload;
        $autoloaderFound = true;
        break;
    }
}

if (! $autoloaderFound) {
    fwrite(STDERR, "Error: Could not find autoloader. Run 'composer install' first.\n");
    exit(1);
}

$targetDir = 'src';
$excludePatterns = ['*Module.php'];
$format = 'text';

foreach ($argv as $i => $arg) {
    if ($i === 0) {
        continue;
    }

    if (str_starts_with($arg, '--exclude=')) {
        $excludePatterns = array_map('trim', explode(',', substr($arg, 10)));
    } elseif ($arg === '--no-exclude') {
        $excludePatterns = [];
    } elseif (str_starts_with($arg, '--format=')) {
        $format = substr($arg, 9);
    } elseif (! str_starts_with($arg, '--')) {
        $targetDir = $arg;
    }
}

$lang = getenv('LANG') ?: 'en';
$docsLocale = str_starts_with($lang, 'ja') ? 'ja' : 'en';
$docsBaseUrl = "https://koriym.github.io/pasta-lunch/issues/{$docsLocale}/";

$pasta = new Pasta($docsBaseUrl);
$targetDirs = array_map('trim', explode(',', $targetDir));
$report = $pasta->analyze($targetDirs, $excludePatterns);

if ($report->totalFiles === 0 || ($report->counts[4] === 0 && $report->counts[3] === 0 && $report->counts[2] === 0)) {
    echo match ($format) {
        'html' => "<!DOCTYPE html><html><head><title>Clean</title></head><body><h1>\u{1F35D} Spaghetti Code Detection</h1><p>All clean! No issues detected.</p></body></html>\n",
        'md' => "## \u{1F35D} Spaghetti Code Detection\n\n\u{2728} All clean! No issues detected.\n",
        default => "\n\u{2728} All clean! No issues detected.\n",
    };
    exit(0);
}

echo match ($format) {
    'html' => $report->toHtml(),
    'md' => $report->toMarkdown(),
    default => $report->toText(),
};
